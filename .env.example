# Copy this file to .env and fill in your real key.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored; this template is committed.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional. Model used for all three chains.
OPENAI_MODEL=gpt-4o-mini

# Optional. 0.0 keeps extraction deterministic; raise only for the email chain
# if the generated tone feels too flat.
OPENAI_TEMPERATURE=0.0

# Optional. Documents processed concurrently. Keep low to stay inside rate limits.
MAX_WORKERS=4

# Optional. DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
