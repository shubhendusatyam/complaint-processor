# Copy this file to .streamlit/secrets.toml for local Streamlit runs, or paste
# its contents into the Secrets panel on Streamlit Community Cloud
# (App menu -> Settings -> Secrets).
#
# .streamlit/secrets.toml is git-ignored. This template is committed.
#
# Running locally with a .env file already works and needs none of this;
# secrets are how the key reaches the app when it is hosted.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-key-here"

# Optional, same meanings as in .env.example.
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_TEMPERATURE = "0.0"
MAX_WORKERS = "4"
LOG_LEVEL = "INFO"
